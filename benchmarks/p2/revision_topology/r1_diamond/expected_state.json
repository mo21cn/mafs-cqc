{
  "scenario": "R1_diamond_fanout",
  "topology": "A0 → {B0, C0} → D0; revision A0→A1; regenerate B1, C1, D1",
  "stages": [
    {
      "stage": "initial_all_current",
      "current_revisions": {"P2B-A": 0, "P2B-B": 0, "P2B-C": 0, "P2B-D": 0},
      "expected": {"P2B-A@0": "current", "P2B-B@0": "current", "P2B-C@0": "current", "P2B-D@0": "current"}
    },
    {
      "stage": "after_revision_A1_before_regeneration",
      "current_revisions": {"P2B-A": 1, "P2B-B": 0, "P2B-C": 0, "P2B-D": 0},
      "expected": {
        "P2B-A@0": "superseded",
        "P2B-A@1": "current",
        "P2B-B@0": "stale",
        "P2B-C@0": "stale",
        "P2B-D@0": "stale"
      }
    },
    {
      "stage": "after_full_regeneration",
      "current_revisions": {"P2B-A": 1, "P2B-B": 1, "P2B-C": 1, "P2B-D": 1},
      "expected": {
        "P2B-A@1": "current",
        "P2B-B@1": "current",
        "P2B-C@1": "current",
        "P2B-D@1": "current",
        "P2B-B@0": "superseded",
        "P2B-C@0": "superseded",
        "P2B-D@0": "superseded"
      }
    }
  ]
}
