{
  "scenario": "R1_diamond_fanout",
  "stages": [
    {
      "stage": "initial_all_current",
      "expected": {
        "P2B-A@0": "current",
        "P2B-B@0": "current",
        "P2B-C@0": "current",
        "P2B-D@0": "current"
      },
      "actual": {
        "P2B-A@0": "current",
        "P2B-B@0": "current",
        "P2B-C@0": "current",
        "P2B-D@0": "current"
      },
      "match": true
    },
    {
      "stage": "after_revision_A1_before_regeneration",
      "expected": {
        "P2B-A@0": "superseded",
        "P2B-A@1": "current",
        "P2B-B@0": "stale",
        "P2B-C@0": "stale",
        "P2B-D@0": "stale"
      },
      "actual": {
        "P2B-A@0": "superseded",
        "P2B-A@1": "current",
        "P2B-B@0": "stale",
        "P2B-C@0": "stale",
        "P2B-D@0": "stale"
      },
      "match": true
    },
    {
      "stage": "after_full_regeneration",
      "expected": {
        "P2B-A@1": "current",
        "P2B-B@1": "current",
        "P2B-C@1": "current",
        "P2B-D@1": "current",
        "P2B-B@0": "superseded",
        "P2B-C@0": "superseded",
        "P2B-D@0": "superseded"
      },
      "actual": {
        "P2B-A@1": "current",
        "P2B-B@1": "current",
        "P2B-C@1": "current",
        "P2B-D@1": "current",
        "P2B-B@0": "superseded",
        "P2B-C@0": "superseded",
        "P2B-D@0": "superseded"
      },
      "match": true
    }
  ]
}
